{
  "manifest_version": 3,
  "name": "AnyClip",
  "version": "1.0.0",
  "description": "AnyClip — Chrome extension",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "offscreen",
    "clipboardRead",
    "clipboardWrite"
  ],
  "commands": {
    "copy-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy current tab URL to clipboard"
    },
    "paste-and-go": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Open clipboard content as URL in new tab"
    },
    "copy-url-and-close": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Copy current tab URL and close the tab"
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
